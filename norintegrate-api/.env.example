# Database (defaults exist in application.yml — override for non-local environments)
DB_USERNAME=norintegrate
DB_PASSWORD=norintegrate

# OAuth 2.0 Resource Server — JWT issuer for token validation
JWT_ISSUER_URI=https://accounts.google.com

# CORS allowed origins (default: http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated admin emails (optional)
# NORINTEGRATE_SECURITY_ADMIN_EMAILS=admin@example.com

# Production only — override datasource URL
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/norintegrate?sslmode=require
