{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(mkdir -p *)",
      "Bash(java -version)",
      "Bash(scripts/check-docs.sh*)",
      "Bash(scripts/check-third-party-drift.sh*)",
      "Bash(scripts/check-third-party-notices-web-drift.sh*)",
      "Bash(scripts/check-third-party-notices-web-build.sh*)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git switch *)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "mcp__terminal__read_terminal",
      "mcp__ccd_pr__get_status"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(/docs/schema.sql)",
      "Edit(/docs/seed.sql)",
      "Bash(git push *)"
    ],
    "deny": [
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(chmod*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch -C *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
