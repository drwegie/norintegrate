{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(mkdir -p *)",
      "Bash(java -version)"
    ],
    "ask": [
      "Edit(CLAUDE.md)",
      "Edit(/docs/schema.sql)",
      "Edit(/docs/seed.sql)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(chmod*)",
      "Bash(curl*)",
      "Bash(wget*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
